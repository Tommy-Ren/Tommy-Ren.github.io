# Public browser configuration only. Put your own values in .env.local.
# Never use a Secret key, service_role JWT or database password here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Enable only after deploying the optional blog-feed Edge Function.
# VITE_BLOG_RSS_ENABLED=true
# A legacy anon key can be supplied as VITE_SUPABASE_ANON_KEY instead.
