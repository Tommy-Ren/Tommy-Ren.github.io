{
  "name": "tommy-ren-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:blog": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "tsc -b && vite build && vite build --ssr src/blog/render.tsx --outDir .preview/blog-ssr && node scripts/build-blog.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:blog": "node --test scripts/blog-content.test.mjs",
    "test:backend": "node --test supabase/tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.344.0",
    "marked": "^18.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.38.0",
    "three": "^0.186.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
